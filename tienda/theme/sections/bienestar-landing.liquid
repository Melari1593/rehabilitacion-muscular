{%- comment -%}
  BienEstar en Casa · Página de inicio
  Sección independiente para temas Online Store 2.0 (probada para Horizon).
  Adaptada del brief "Align Clinic": misma estética (blanco, azul marino, azul eléctrico,
  DM Serif Display + Plus Jakarta Sans), pero con Liquid + CSS + JS nativo en lugar de
  React/Framer Motion, y con contenido real de la tienda (sin datos inventados).
{%- endcomment -%}

{%- liquid
  assign sid = 'bel-' | append: section.id
  assign cursos = section.settings.coleccion_cursos
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@300;400;600&display=swap" rel="stylesheet">

<style>
  #{{ sid }} {
    --bel-bg: #ffffff;
    --bel-navy: #1a2440;
    --bel-blue: #1a8cd4;
    --bel-blue-soft: rgba(26, 140, 212, 0.1);
    --bel-grey: #f5f5f7;
    /* Más oscuro que el #8a8fa8 del brief para cumplir contraste AA en texto pequeño */
    --bel-muted: #5f6680;
    --bel-border: #dde1ea;
    --bel-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --bel-serif: 'DM Serif Display', Georgia, serif;
    --bel-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-family: var(--bel-sans);
    color: var(--bel-navy);
    background: var(--bel-bg);
  }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} .bel-wrap { padding: 96px 6%; }
  #{{ sid }} .bel-grey { background: var(--bel-grey); }
  #{{ sid }} .bel-eyebrow {
    font-weight: 600; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--bel-blue); margin: 0 0 12px;
  }
  #{{ sid }} .bel-h2 {
    font-family: var(--bel-serif); font-weight: 400; font-size: clamp(30px, 4vw, 48px);
    line-height: 1.1; margin: 0 0 56px; max-width: 760px;
  }
  #{{ sid }} .bel-chip {
    display: inline-block; background: var(--bel-blue-soft); color: var(--bel-blue);
    font-weight: 600; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    border-radius: 100px; padding: 5px 14px;
  }
  #{{ sid }} .bel-btn {
    display: inline-block; font-family: var(--bel-sans); font-weight: 600; font-size: 14px;
    text-decoration: none; border-radius: 8px; padding: 14px 28px; transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  #{{ sid }} .bel-btn--navy { background: var(--bel-navy); color: #fff; border: 1.5px solid var(--bel-navy); }
  #{{ sid }} .bel-btn--navy:hover { background: var(--bel-blue); border-color: var(--bel-blue); }
  #{{ sid }} .bel-btn--line { background: transparent; color: var(--bel-navy); border: 1.5px solid var(--bel-navy); }
  #{{ sid }} .bel-btn--line:hover { color: var(--bel-blue); border-color: var(--bel-blue); }
  #{{ sid }} .bel-btn--blue { background: var(--bel-blue); color: #fff; font-size: 15px; padding: 16px 40px; }
  #{{ sid }} .bel-btn--blue:hover { background: #1577b5; }
  #{{ sid }} .bel-btn:focus-visible { outline: 2px solid var(--bel-blue); outline-offset: 3px; }

  /* Hero */
  #{{ sid }} .bel-hero { display: grid; grid-template-columns: 48% 52%; min-height: min(100vh, 820px); }
  #{{ sid }} .bel-hero__text {
    display: flex; flex-direction: column; justify-content: center; padding: 64px 6% 64px 8%;
  }
  #{{ sid }} .bel-hero__text > * { max-width: 560px; }
  #{{ sid }} .bel-hero h1 {
    font-family: var(--bel-serif); font-weight: 400; font-size: clamp(42px, 6vw, 88px);
    line-height: 1.0; margin: 20px 0;
  }
  #{{ sid }} .bel-hero__sub { font-size: 16px; line-height: 1.6; color: var(--bel-muted); margin: 0 0 36px; }
  #{{ sid }} .bel-hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  #{{ sid }} .bel-card-float {
    margin-top: 32px; max-width: 340px; background: #fff; border-radius: 12px;
    border: 0.5px solid var(--bel-border); box-shadow: 0 8px 32px rgba(26, 36, 64, 0.10); padding: 16px 20px;
    text-decoration: none; display: block;
  }
  #{{ sid }} .bel-card-float .bel-chip { font-size: 10px; padding: 4px 12px; }
  #{{ sid }} .bel-card-float strong { display: block; font-weight: 600; font-size: 14px; margin-top: 10px; }
  #{{ sid }} .bel-card-float small { display: block; font-weight: 300; font-size: 12px; color: var(--bel-muted); margin-top: 4px; }
  #{{ sid }} .bel-hero__media { position: relative; overflow: hidden; background: var(--bel-grey); }
  #{{ sid }} .bel-hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  #{{ sid }} .bel-hero__media::before {
    content: ''; position: absolute; inset: 0 auto 0 0; width: 18%; z-index: 1; pointer-events: none;
    background: linear-gradient(to right, #fff 0%, rgba(255, 255, 255, 0) 100%);
  }
  #{{ sid }} .bel-hero__placeholder { width: 100%; height: 100%; }

  /* Temas */
  #{{ sid }} .bel-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  #{{ sid }} .bel-tema {
    display: block; text-decoration: none; background: #fff; border: 1px solid var(--bel-border);
    border-radius: 8px; padding: 24px 20px; transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  #{{ sid }} .bel-tema svg { width: 22px; height: 22px; color: var(--bel-blue); transition: color 0.2s ease; }
  #{{ sid }} .bel-tema h3 { font-weight: 600; font-size: 15px; margin: 14px 0 6px; }
  #{{ sid }} .bel-tema p { font-weight: 300; font-size: 13px; line-height: 1.5; color: var(--bel-muted); margin: 0; transition: color 0.2s ease; }
  #{{ sid }} a.bel-tema:hover, #{{ sid }} a.bel-tema:focus-visible {
    background: var(--bel-blue); color: #fff; border-color: transparent; box-shadow: 0 4px 16px rgba(26, 140, 212, 0.25); outline: none;
  }
  #{{ sid }} a.bel-tema:hover svg, #{{ sid }} a.bel-tema:focus-visible svg { color: #fff; }
  #{{ sid }} a.bel-tema:hover p, #{{ sid }} a.bel-tema:focus-visible p { color: rgba(255, 255, 255, 0.85); }

  /* Pasos */
  #{{ sid }} .bel-paso { position: relative; padding-top: 8px; }
  #{{ sid }} .bel-paso__num {
    position: absolute; top: -8px; left: 0; font-weight: 600; font-size: 72px; line-height: 1;
    color: var(--bel-navy); opacity: 0.05; user-select: none; pointer-events: none;
  }
  #{{ sid }} .bel-paso__line { width: 40px; height: 2px; background: var(--bel-blue); margin: 40px 0 20px; }
  #{{ sid }} .bel-paso h3 { font-weight: 600; font-size: 18px; margin: 0 0 8px; }
  #{{ sid }} .bel-paso p { font-size: 15px; line-height: 1.6; color: var(--bel-muted); margin: 0; }
  #{{ sid }} .bel-paso small { display: block; font-weight: 300; font-size: 12px; color: var(--bel-blue); margin-top: 12px; }

  /* Cursos (productos reales de la colección) */
  #{{ sid }} .bel-curso {
    display: flex; flex-direction: column; background: #fff; border: 1px solid var(--bel-border);
    border-radius: 12px; overflow: hidden; text-decoration: none; transition: box-shadow 0.2s ease;
  }
  #{{ sid }} .bel-curso:hover { box-shadow: 0 8px 32px rgba(26, 36, 64, 0.10); }
  #{{ sid }} .bel-curso__img { aspect-ratio: 1 / 1; background: var(--bel-grey); }
  #{{ sid }} .bel-curso__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #{{ sid }} .bel-curso__body { padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  #{{ sid }} .bel-curso__body h3 { font-weight: 600; font-size: 17px; margin: 0; }
  #{{ sid }} .bel-curso__price { font-weight: 600; font-size: 20px; margin-top: auto; padding-top: 8px; }
  #{{ sid }} .bel-empty { color: var(--bel-muted); font-size: 15px; }

  /* Revisión médica */
  #{{ sid }} .bel-medico {
    display: grid; grid-template-columns: 160px 1fr; gap: 28px; align-items: center; max-width: 760px;
    background: #fff; border: 1px solid var(--bel-border); border-radius: 12px; padding: 24px;
  }
  #{{ sid }} .bel-medico--sinfoto { grid-template-columns: 1fr; }
  #{{ sid }} .bel-medico img { width: 160px; height: 160px; object-fit: cover; border-radius: 8px; display: block; }
  #{{ sid }} .bel-medico h3 { font-weight: 600; font-size: 18px; margin: 0 0 8px; }
  #{{ sid }} .bel-medico p { font-size: 14px; line-height: 1.6; color: var(--bel-muted); margin: 12px 0 0; }

  /* Franja de confianza */
  #{{ sid }} .bel-strip { background: var(--bel-navy); padding: 28px 0; overflow: hidden; }
  #{{ sid }} .bel-strip__track { display: flex; width: max-content; animation: bel-marquee-{{ section.id }} 30s linear infinite; }
  #{{ sid }} .bel-strip:hover .bel-strip__track { animation-play-state: paused; }
  #{{ sid }} .bel-strip__group { display: flex; flex-shrink: 0; }
  #{{ sid }} .bel-strip span { color: rgba(255, 255, 255, 0.85); font-size: 13px; white-space: nowrap; padding: 0 20px; }
  #{{ sid }} .bel-strip span::after { content: '·'; color: var(--bel-blue); margin-left: 40px; }
  @keyframes bel-marquee-{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* Testimonios */
  #{{ sid }} .bel-testis { display: grid; gap: 20px; max-width: 720px; margin: 0 auto; }
  #{{ sid }} .bel-testi { background: #fff; border: 1px solid var(--bel-border); border-radius: 12px; padding: 28px 32px; margin: 0; }
  #{{ sid }} .bel-testi blockquote { font-style: italic; font-size: 16px; line-height: 1.65; margin: 0; }
  #{{ sid }} .bel-testi figcaption { font-weight: 600; font-size: 13px; color: var(--bel-blue); margin-top: 16px; }

  /* CTA final */
  #{{ sid }} .bel-cta { background: var(--bel-navy); text-align: center; padding: 120px 6%; color: #fff; }
  #{{ sid }} .bel-cta h2 { font-family: var(--bel-serif); font-weight: 400; font-size: clamp(30px, 4.5vw, 64px); margin: 0; line-height: 1.1; }
  #{{ sid }} .bel-cta p { font-size: 18px; color: rgba(255, 255, 255, 0.75); margin: 16px 0 40px; }
  #{{ sid }} .bel-cta small { display: block; font-weight: 300; font-size: 13px; color: rgba(255, 255, 255, 0.6); margin-top: 16px; }
  #{{ sid }} .bel-aviso { font-weight: 300; font-size: 12px; color: var(--bel-muted); text-align: center; padding: 20px 6%; margin: 0; }

  /* Animaciones de entrada (sustituyen a Framer Motion) */
  #{{ sid }} [data-bel-reveal] { opacity: 0; transform: translateY(20px); transition: opacity 0.7s var(--bel-ease), transform 0.7s var(--bel-ease); }
  #{{ sid }} [data-bel-reveal].is-visible { opacity: 1; transform: none; }
  #{{ sid }} .bel-card-float[data-bel-reveal] { transform: scale(0.9); }
  #{{ sid }} .bel-card-float[data-bel-reveal].is-visible { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    #{{ sid }} [data-bel-reveal] { opacity: 1; transform: none; transition: none; }
    #{{ sid }} .bel-strip__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    #{{ sid }} .bel-strip__group[aria-hidden] { display: none; }
  }

  /* Responsive */
  @media (max-width: 989px) {
    #{{ sid }} .bel-hero { grid-template-columns: 1fr; min-height: 0; }
    #{{ sid }} .bel-hero__media { order: -1; aspect-ratio: 4 / 3; }
    #{{ sid }} .bel-hero__media::before { display: none; }
    #{{ sid }} .bel-hero__text { padding: 48px 6%; }
    #{{ sid }} .bel-grid-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 599px) {
    #{{ sid }} .bel-wrap { padding: 64px 5%; }
    #{{ sid }} .bel-grid-3 { grid-template-columns: 1fr; }
    #{{ sid }} .bel-medico { grid-template-columns: 1fr; }
    #{{ sid }} .bel-cta { padding: 80px 5%; }
    #{{ sid }} .bel-testi { padding: 24px; }
  }
</style>

<div id="{{ sid }}">

  {%- comment -%} 1. Hero {%- endcomment -%}
  <section class="bel-hero" aria-labelledby="{{ sid }}-titulo">
    <div class="bel-hero__text">
      {%- if section.settings.hero_chip != blank -%}
        <p data-bel-reveal><span class="bel-chip">{{ section.settings.hero_chip }}</span></p>
      {%- endif -%}
      <h1 id="{{ sid }}-titulo" data-bel-reveal>{{ section.settings.hero_titulo }}</h1>
      <p class="bel-hero__sub" data-bel-reveal style="transition-delay: 0.15s">{{ section.settings.hero_texto }}</p>
      <div class="bel-hero__ctas" data-bel-reveal style="transition-delay: 0.15s">
        {%- if section.settings.cta1_texto != blank -%}
          <a class="bel-btn bel-btn--navy" href="{{ section.settings.cta1_link | default: '/collections/all' }}">{{ section.settings.cta1_texto }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_texto != blank -%}
          <a class="bel-btn bel-btn--line" href="{{ section.settings.cta2_link | default: '/collections/all' }}">{{ section.settings.cta2_texto }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.destacado_titulo != blank -%}
        <a class="bel-card-float" href="{{ section.settings.destacado_link | default: '#' }}" data-bel-reveal style="transition-delay: 0.5s">
          <span class="bel-chip">{{ section.settings.destacado_chip }}</span>
          <strong>{{ section.settings.destacado_titulo }}</strong>
          <small>{{ section.settings.destacado_detalle }}</small>
        </a>
      {%- endif -%}
    </div>
    <div class="bel-hero__media">
      {%- if section.settings.hero_imagen != blank -%}
        {%- assign hero_alt = section.settings.hero_imagen.alt | default: section.settings.hero_titulo -%}
        {{ section.settings.hero_imagen | image_url: width: 1600 | image_tag:
          loading: 'eager', fetchpriority: 'high',
          sizes: '(min-width: 990px) 52vw, 100vw',
          widths: '600, 900, 1200, 1600',
          alt: hero_alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'bel-hero__placeholder' }}
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} 2. Franja de confianza (solo datos verificables) {%- endcomment -%}
  {%- assign items_franja = section.settings.franja | newline_to_br | split: '<br />' -%}
  {%- if section.settings.franja != blank -%}
    <div class="bel-strip" role="region" aria-label="Datos de la tienda">
      <div class="bel-strip__track">
        {%- for copia in (1..2) -%}
          <div class="bel-strip__group"{% if copia == 2 %} aria-hidden="true"{% endif %}>
            {%- for item in items_franja -%}
              {%- assign texto = item | strip -%}
              {%- if texto != blank %}<span>{{ texto }}</span>{% endif -%}
            {%- endfor -%}
            {%- for item in items_franja -%}
              {%- assign texto = item | strip -%}
              {%- if texto != blank %}<span>{{ texto }}</span>{% endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} 3. Temas (bloques editables) {%- endcomment -%}
  {%- assign temas = section.blocks | where: 'type', 'tema' -%}
  {%- if temas.size > 0 -%}
    <section class="bel-wrap bel-grey" aria-labelledby="{{ sid }}-temas">
      <p class="bel-eyebrow">{{ section.settings.temas_eyebrow }}</p>
      <h2 class="bel-h2" id="{{ sid }}-temas">{{ section.settings.temas_titulo }}</h2>
      <div class="bel-grid-3">
        {%- for block in temas -%}
          {%- capture icono -%}
            {%- case block.settings.icono -%}
              {%- when 'espalda' -%}<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
              {%- when 'rodilla' -%}<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              {%- when 'masaje' -%}<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/>
              {%- when 'fuerza' -%}<path d="M6.5 6.5v11M17.5 6.5v11M3 9.5v5M21 9.5v5M6.5 12h11"/>
              {%- when 'frio' -%}<line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/>
              {%- else -%}<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/>
            {%- endcase -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a class="bel-tema" href="{{ block.settings.link }}" data-bel-reveal style="transition-delay: {{ forloop.index0 | times: 0.07 | round: 2 }}s" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="bel-tema" data-bel-reveal style="transition-delay: {{ forloop.index0 | times: 0.07 | round: 2 }}s" {{ block.shopify_attributes }}>
          {%- endif -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ icono }}</svg>
              <h3>{{ block.settings.titulo }}</h3>
              <p>{{ block.settings.texto }}</p>
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 4. Cómo funciona {%- endcomment -%}
  <section class="bel-wrap" aria-labelledby="{{ sid }}-pasos">
    <p class="bel-eyebrow">{{ section.settings.pasos_eyebrow }}</p>
    <h2 class="bel-h2" id="{{ sid }}-pasos">{{ section.settings.pasos_titulo }}</h2>
    <div class="bel-grid-3">
      {%- assign pasos = section.blocks | where: 'type', 'paso' -%}
      {%- for block in pasos -%}
        <div class="bel-paso" data-bel-reveal style="transition-delay: {{ forloop.index0 | times: 0.15 | round: 2 }}s" {{ block.shopify_attributes }}>
          <span class="bel-paso__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="bel-paso__line"></div>
          <h3>{{ block.settings.titulo }}</h3>
          <p>{{ block.settings.texto }}</p>
          {%- if block.settings.nota != blank %}<small>{{ block.settings.nota }}</small>{% endif -%}
        </div>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} 5. Cursos: productos reales de la colección, con su precio de Shopify {%- endcomment -%}
  <section class="bel-wrap bel-grey" aria-labelledby="{{ sid }}-cursos">
    <p class="bel-eyebrow">{{ section.settings.cursos_eyebrow }}</p>
    <h2 class="bel-h2" id="{{ sid }}-cursos">{{ section.settings.cursos_titulo }}</h2>
    {%- if cursos != blank and cursos.products_count > 0 -%}
      <div class="bel-grid-3">
        {%- for product in cursos.products limit: section.settings.cursos_max -%}
          <a class="bel-curso" href="{{ product.url }}" data-bel-reveal style="transition-delay: {{ forloop.index0 | times: 0.12 | round: 2 }}s">
            <div class="bel-curso__img">
              {%- if product.featured_image -%}
                {%- assign curso_alt = product.featured_image.alt | default: product.title -%}
                {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, (min-width: 600px) 45vw, 90vw', widths: '350, 500, 700', alt: curso_alt }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="bel-curso__body">
              <span class="bel-chip">{{ section.settings.cursos_chip }}</span>
              <h3>{{ product.title | remove_first: 'Curso: ' }}</h3>
              <span class="bel-curso__price">{{ product.price | money }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {%- if cursos.products_count > section.settings.cursos_max -%}
        <p style="margin-top: 32px"><a class="bel-btn bel-btn--line" href="{{ cursos.url }}">Ver todos los cursos</a></p>
      {%- endif -%}
    {%- else -%}
      <p class="bel-empty">Muy pronto: estamos preparando nuestros cursos.</p>
    {%- endif -%}
  </section>

  {%- comment -%} 6. Revisión médica {%- endcomment -%}
  {%- if section.settings.medico_registro != blank -%}
    <section class="bel-wrap" aria-labelledby="{{ sid }}-medico">
      <p class="bel-eyebrow">{{ section.settings.medico_eyebrow }}</p>
      <h2 class="bel-h2" id="{{ sid }}-medico">{{ section.settings.medico_titulo }}</h2>
      <div class="bel-medico{% if section.settings.medico_foto == blank %} bel-medico--sinfoto{% endif %}" data-bel-reveal>
        {%- if section.settings.medico_foto != blank -%}
          {%- assign medico_alt = section.settings.medico_nombre | default: 'Médico revisor' -%}
          {{ section.settings.medico_foto | image_url: width: 320 | image_tag: loading: 'lazy', alt: medico_alt }}
        {%- endif -%}
        <div>
          <h3>{{ section.settings.medico_nombre | default: 'Médico revisor' }}</h3>
          <span class="bel-chip">{{ section.settings.medico_registro }}</span>
          {%- if section.settings.medico_texto != blank %}<p>{{ section.settings.medico_texto }}</p>{% endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 7. Testimonios: solo se muestra si agregas reseñas reales {%- endcomment -%}
  {%- assign testimonios = section.blocks | where: 'type', 'testimonio' -%}
  {%- if testimonios.size > 0 -%}
    <section class="bel-wrap bel-grey" aria-labelledby="{{ sid }}-testis">
      <p class="bel-eyebrow" style="text-align: center">{{ section.settings.testis_eyebrow }}</p>
      <h2 class="bel-h2" id="{{ sid }}-testis" style="text-align: center; margin-left: auto; margin-right: auto">{{ section.settings.testis_titulo }}</h2>
      <div class="bel-testis">
        {%- for block in testimonios -%}
          <figure class="bel-testi" data-bel-reveal style="transition-delay: {{ forloop.index0 | times: 0.15 | round: 2 }}s" {{ block.shopify_attributes }}>
            <blockquote>“{{ block.settings.cita }}”</blockquote>
            <figcaption>{{ block.settings.nombre }}{% if block.settings.ciudad != blank %}, {{ block.settings.ciudad }}{% endif %}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 8. CTA final {%- endcomment -%}
  <section class="bel-cta" aria-labelledby="{{ sid }}-cta">
    <div data-bel-reveal>
      <h2 id="{{ sid }}-cta">{{ section.settings.cta_titulo }}</h2>
      <p>{{ section.settings.cta_texto }}</p>
      <a class="bel-btn bel-btn--blue" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_boton }}</a>
      {%- if section.settings.cta_nota != blank %}<small>{{ section.settings.cta_nota }}</small>{% endif -%}
    </div>
  </section>

  <p class="bel-aviso">{{ section.settings.aviso }}</p>
</div>

<script>
  (function () {
    var root = document.getElementById('{{ sid }}');
    if (!root) return;
    var items = root.querySelectorAll('[data-bel-reveal]');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px' });
    items.forEach(function (el) { io.observe(el); });
  })();
</script>

