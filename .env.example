# Dominio .myshopify.com de la tienda (no el dominio personalizado)
SHOPIFY_STORE_DOMAIN=ndhgpy-aw.myshopify.com
# Token público de la Storefront API (canal "Headless" en Shopify)
SHOPIFY_STOREFRONT_TOKEN=
# Versión de la Storefront API
SHOPIFY_API_VERSION=2026-07
# Colecciones que se muestran en el sitio
SHOPIFY_COLECCION_CURSOS=cursos-en-linea
SHOPIFY_COLECCION_PRODUCTOS=rehabilitacion-y-bienestar
# Solo para desarrollo local sin token: muestra datos de ejemplo con los botones de compra desactivados
# MOCK_CATALOG=1

# --- Wompi (pagos de los cursos) ---
# Panel de Wompi → Desarrolladores. En modo de prueba las llaves empiezan por pub_test_, test_integrity_ y test_events_.
# Con una llave pub_test_ el sitio usa el sandbox de Wompi y muestra el aviso "Modo de prueba".
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# URL pública del sitio (para la redirect-url de Wompi). Opcional: si falta se usa el dominio de la petición.
# SITE_URL=https://tu-dominio.com

# --- Correo con el acceso al curso (opcional, https://resend.com) ---
# RESEND_API_KEY=
# CORREO_REMITENTE=BienEstar en Casa <cursos@orquidbio.com>
# Enlace de acceso por curso (se incluye en el correo):
# CURSO_ACCESO_ESPALDA_SANA=
# CURSO_ACCESO_RODILLAS_FUERTES=
# CURSO_ACCESO_AUTOMASAJE=
# CURSO_ACCESO_BANDAS_ELASTICAS=
# CURSO_ACCESO_FRIO_O_CALOR=
