# Dominio .myshopify.com de la tienda (no el dominio personalizado)
SHOPIFY_STORE_DOMAIN=ndhgpy-aw.myshopify.com
# Token público de la Storefront API (canal "Headless" en Shopify)
SHOPIFY_STOREFRONT_TOKEN=
# Versión de la Storefront API
SHOPIFY_API_VERSION=2026-07
# Colecciones que se muestran en el sitio
SHOPIFY_COLECCION_CURSOS=cursos-en-linea
SHOPIFY_COLECCION_PRODUCTOS=rehabilitacion-y-bienestar
# Solo para desarrollo local sin token: muestra datos de ejemplo con los botones de compra desactivados
# MOCK_CATALOG=1
